# DentFlow API production template. Copy to a server-side secret store; never commit real values.
NODE_ENV=production
HOST=0.0.0.0
PORT=8787
DATABASE_URL=postgresql://USER:PASSWORD@DB_HOST:5432/dentflow
DATABASE_SSL=true
TRUST_PROXY=true

# AWS S3 private clinical assets. All three values are required together.
ASSET_BUCKET=dentflow-private-assets
ASSET_REGION=ap-northeast-1
ASSET_BUCKET_OWNER=123456789012

# Optional: when omitted, S3 AES256 server-side encryption is used.
# ASSET_KMS_KEY_ID=arn:aws:kms:REGION:ACCOUNT:key/KEY_ID

# AWS credentials are intentionally absent. Use the AWS SDK default credential
# provider chain, preferably an IAM role attached to the API runtime.
